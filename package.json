{
  "name": "wick-broker-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run build:app && npm run build:packages",
    "start": "node dist/src/server/index.js",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/marketplace*.test.ts",
    "test:browser": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "seed:production": "node dist/scripts/seed.js",
    "format": "prettier --write src scripts tests *.ts *.json",
    "test:recovery": "tsx scripts/verify-recovery.ts",
    "db:migrate:production": "node dist/scripts/migrate.js",
    "configure:real:production": "node dist/scripts/configure-real.js",
    "build:app": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "build:packages": "npm run build --workspace @wick-cloud/broker-sdk && npm run build --workspace @wick-cloud/broker-cli && npm run build --workspace @wick-cloud/broker-mcp && npm rebuild --workspace @wick-cloud/broker-cli --workspace @wick-cloud/broker-mcp --ignore-scripts",
    "pretest": "npm run build:packages",
    "test:developer-e2e": "npm run build:packages && tsx tests/developer-access-e2e.ts",
    "inference:readiness": "tsx scripts/inference-readiness.ts",
    "test:inference-live": "npm run build:packages && tsx tests/inference-live-e2e.ts",
    "test:coding-local": "tsx tests/coding-local-e2e.ts",
    "test:studio-local": "CODING_LOCAL_STUDIO=1 tsx tests/coding-local-e2e.ts",
    "test:studio-live": "tsx tests/studio-inference-live-e2e.ts",
    "studio:usage:evaluate": "tsx scripts/evaluate-studio-usage.ts",
    "audit": "npm audit --audit-level=info",
    "format:check": "node scripts/check-format.mjs",
    "test:static": "node scripts/verify-static.mjs",
    "test:docker": "bash scripts/verify-container.sh",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test:restore": "tsx scripts/verify-backup-restore.ts"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@wick-cloud/sdk": "0.1.0-rc.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.3.27",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "railway": "3.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "workspaces": [
    "packages/sdk",
    "packages/cli",
    "packages/mcp"
  ],
  "overrides": {
    "@fastify/static": {
      "glob": "14.0.2"
    }
  },
  "license": "MIT"
}
