NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://wick:wick_local_only@localhost:5432/wick_broker
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Opt in only for auth traffic through Railway's public HTTP edge, which overwrites
# X-Real-IP. This isolates auth rate limits by client IP without trusting XFF chains.
# Private *.railway.internal and TCP ingress do not sanitize this header.
AUTH_TRUST_RAILWAY_PROXY=false
# Homepage live demo: separate guest identity, Modal Micro VM + Baseten token auction.
# Default off. Requires real qualified routes, native disks and preflight verification.
# Fixed limits: two active runs, $5/day conservative reservations, 20-minute cooldown.
LIVE_DEMO_ENABLED=false
# Explicit simulation is allowed only outside production; never a real-call fallback.
LIVE_DEMO_ALLOW_FIXTURES=false
# Required explicit selection. Fixtures never call Wick or Meta and never become real fallback.
WICK_MODE=fixture
MUSE_MODE=fixture
WICK_API_BASE=https://app.wick-cloud.com/api
WICK_API_KEY=
WICK_ORGANIZATION_ID=demo-organization
WICK_GROUP_ID=demo-group
META_API_BASE=https://inference.baseten.co/v1
BASETEN_API_KEY=
# Legacy server-only alias; BASETEN_API_KEY takes precedence when both are supplied.
META_API_KEY=
# Optional token marketplace, in this same app and Postgres. Default off.
# Fixture mode uses simulated quota/responses and reserves pilot Broker credit.
INFERENCE_MARKET_MODE=off
# Server-only operator accounting evidence; see docs/inference-marketplace.md.
INFERENCE_QUALIFICATION_FILE=
# Railway can supply the same bounded JSON in a sealed server variable without a volume.
# Set exactly one of JSON or FILE.
INFERENCE_QUALIFICATION_JSON=
# Defaults to the existing server Baseten Muse key if omitted. Never a browser variable.
INFERENCE_BASETEN_API_KEY=
INFERENCE_BASETEN_PROVIDER_EMAIL=baseten@providers.wick.local
INFERENCE_MODAL_PROVIDER_EMAIL=modal@providers.wick.local
# Actual SharedEndpoint hostname returned by GET /v1/models, not the creation slug.
INFERENCE_MODAL_MODEL=
# A Modal inference proxy token; VM credentials are a separate credential type.
INFERENCE_MODAL_PROXY_TOKEN=
MAX_CONCURRENT_VMS=20
# Real Studio execution qualification: up to 16 existing approved catalog IDs, comma-separated.
# Empty disables new real Studio admission. Ordinary VM rental/terminal routes are unaffected.
STUDIO_APPROVED_COMPUTE_CATALOG_IDS=
# Broker takes a fixed 15% commission from provider rental revenue; no added buyer fee.
# Explicit seed only. All passwords must be supplied and 12 to 128 characters.
SEED_BUYER_EMAIL=buyer@demo.wick.local
SEED_BUYER_PASSWORD=
SEED_SUPPLIER_A_EMAIL=supplier-a@demo.wick.local
SEED_SUPPLIER_A_PASSWORD=
SEED_SUPPLIER_B_EMAIL=supplier-b@demo.wick.local
SEED_SUPPLIER_B_PASSWORD=
SEED_SUPPLIER_C_EMAIL=supplier-c@demo.wick.local
SEED_SUPPLIER_C_PASSWORD=
SEED_ADMIN_EMAIL=admin@demo.wick.local
SEED_ADMIN_PASSWORD=

# Persistent shared workspaces. Use * for all approved native-mount-capable shapes,
# or a comma-separated catalog allowlist for a restricted rollout.
DISKS_ENABLED=false
# * enables all approved native-mount shapes; exact IDs restrict a rollout (real mode).
DISK_QUALIFIED_CATALOG_IDS=

# Explicit registered-provider onboarding only; --apply-providers defaults to staging.
# Use --providers <subset> or this list. Native IDs and environment keys are accepted.
REAL_PROVIDER_IDS=sail,tenki,freestyle,boat
# Only selected accounts need EMAIL/CATALOG_IDS; PASSWORD is required only for new accounts.
# Copy exact catalog IDs from configure-real --list using the reviewed Wick credential/scope.
# Per-provider capacity overrides any existing shared REAL_PROVIDER_CAPACITY (historically 5).
# New one-slot accounts start with automatic bidding off, inactive offers, unapproved new routes.
REAL_PROVIDER_SAIL_EMAIL=
REAL_PROVIDER_SAIL_PASSWORD=
REAL_PROVIDER_SAIL_CATALOG_IDS=
REAL_PROVIDER_SAIL_CAPACITY=1
REAL_PROVIDER_TENKI_EMAIL=
REAL_PROVIDER_TENKI_PASSWORD=
REAL_PROVIDER_TENKI_CATALOG_IDS=
REAL_PROVIDER_TENKI_CAPACITY=1
REAL_PROVIDER_FREESTYLE_EMAIL=
REAL_PROVIDER_FREESTYLE_PASSWORD=
REAL_PROVIDER_FREESTYLE_CATALOG_IDS=
REAL_PROVIDER_FREESTYLE_CAPACITY=1
REAL_PROVIDER_BOAT_EMAIL=
REAL_PROVIDER_BOAT_PASSWORD=
REAL_PROVIDER_BOAT_CATALOG_IDS=
REAL_PROVIDER_BOAT_CAPACITY=1
# Optional REAL_PROVIDER_<KEY>_AUTO_BID=false keeps automation off on explicit --activate.
# Omit REAL_RETIRED_SUPPLIER_EMAILS unless intentionally retiring unbound legacy suppliers.
# --activate enables qualified selections; --update-existing deliberately replaces defaults.

# Operator-funded Modal compute auctions: buyer pays $0.01, operator covers compute.
# Limited to verified Modal routes costing at most $1 upstream per rental.
# Other providers retain cost floors; resources, capacity, deadlines and VM limits apply.
MODAL_COMPUTE_PROMOTION_ENABLED=false
